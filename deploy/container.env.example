# Copy outside repository. Place cert, key, allowlist and optional TURN
# secret in an operator-controlled read-only directory readable by UID 10001.
# Container address is not the host's advertised address.
REMOTE_EX_SIGNAL_BIND=0.0.0.0:47822
REMOTE_EX_PUBLIC_BIND=1
REMOTE_EX_TLS_CERT=/etc/remote-ex/fullchain.pem
REMOTE_EX_TLS_KEY=/etc/remote-ex/privkey.pem
REMOTE_EX_SERVER_ID=REPLACE_WITH_64_LOWERCASE_HEX_CHARS
REMOTE_EX_ALLOWED_DEVICES_FILE=/etc/remote-ex/allowed-devices.txt
# REMOTE_EX_STUN_URL=stun://relay.example.net:3478
# REMOTE_EX_TURN_URL=turns://relay.example.net:5349
# REMOTE_EX_TURN_SECRET_FILE=/etc/remote-ex/turn-secret

# Optional M6 pool instead of the single TURN URL + secret pair (not in alpha.2):
# REMOTE_EX_RELAY_POOL_FILE=/etc/remote-ex/relay-pool.json
# REMOTE_EX_RELAY_REGION=asia
