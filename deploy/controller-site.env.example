# Set in the reviewed service environment, not via untrusted input.
# Dedicated TLS-only static controller site. No signaling proxy.
REMOTE_EX_SITE_BIND=127.0.0.1
REMOTE_EX_SITE_PORT=8443
REMOTE_EX_SITE_HOST=controller.example.net
REMOTE_EX_SITE_TLS_CERT=/etc/remote-ex-site/fullchain.pem
REMOTE_EX_SITE_TLS_KEY=/etc/remote-ex-site/privkey.pem
# Explicit only after operator firewall/TLS/enrollment review:
# REMOTE_EX_SITE_PUBLIC_BIND=1
# REMOTE_EX_SITE_BIND=192.0.2.10
# REMOTE_EX_SITE_PORT=443
