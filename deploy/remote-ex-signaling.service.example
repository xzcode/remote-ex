[Unit]
Description=Remote EX enrolled signaling (review before enabling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remote-ex
Group=remote-ex
EnvironmentFile=/etc/remote-ex/signaling.env
ExecStart=/usr/local/bin/remote-ex-rendezvous
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=1024
TasksMax=128
MemoryMax=512M

[Install]
WantedBy=multi-user.target
