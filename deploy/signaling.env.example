# Example only. Do not store private keys or secrets in this file.
REMOTE_EX_SIGNAL_BIND=127.0.0.1:47822
# For an explicitly enrolled, reviewed TLS-only deployment:
# REMOTE_EX_SIGNAL_BIND=192.0.2.10:47822
# REMOTE_EX_PUBLIC_BIND=1
# REMOTE_EX_TLS_CERT=/etc/remote-ex/tls/fullchain.pem
# REMOTE_EX_TLS_KEY=/etc/remote-ex/tls/privkey.pem
# REMOTE_EX_SERVER_ID=REPLACE_WITH_64_HEX_CHARS
# REMOTE_EX_ALLOWED_DEVICES_FILE=/etc/remote-ex/allowed-devices.txt
# REMOTE_EX_STUN_URL=stun://relay.example.net:3478
# REMOTE_EX_TURN_URL=turns://relay.example.net:5349
# REMOTE_EX_TURN_SECRET_FILE=/etc/remote-ex/turn-secret

# New server: validate this environment using remote-ex-rendezvous --check-config
# before explicitly starting the service. The preflight never opens a port.

# Optional M6 pool instead of the single TURN URL + secret pair (not in alpha.2):
# REMOTE_EX_RELAY_POOL_FILE=/etc/remote-ex/relay-pool.json
# REMOTE_EX_RELAY_REGION=asia

# Optional exact HTTPS origin for reviewed browser clients; M6 source only.
# Requires TLS and explicit device enrollment. No default browser origin.
# REMOTE_EX_WEB_ORIGIN=https://your-reviewed-web-origin.example.net
